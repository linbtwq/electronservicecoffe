// ============================================================
// вспомогательные функции
// ============================================================

// ищет пользователя и сотрудника по коду карты (пин коду)
// возвращает структуру с ключами пользователь и сотрудник
// если ничего не найдено возвращает пустые ссылки
// эту функцию зовут почти все методы ниже чтобы понять кто делает запрос
// пин код с фронта приходит в параметре u (get) или technician_id (post)
Функция ВернутьПараметрыСотрудника(КодСотр)
	// структура в которую сложим ответ
	Результат = Новый Структура;
	// убираем пробелы по краям чтобы пин с лишним пробелом не ломал поиск
	КодСотр = СокрЛП(КодСотр);
	// заранее готовим пустые ссылки чтобы вернуть их если никого не нашли
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Пользователь = Справочники.Пользователи.ПустаяСсылка();

	// пустой код сразу отдаем пустой результат
	// нет смысла гонять запрос в базу с пустым условием
	Если ПустаяСтрока(КодСотр) Тогда
		Результат.Вставить("Пользователь", Пользователь);
		Результат.Вставить("Сотрудник", Сотрудник);
		Возврат Результат;
	КонецЕсли;

	// ищем пользователя по полю код карты
	// первые 1 потому что пин должен быть уникальным
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка,
	|	Пользователи.Сотрудник КАК Сотрудник
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.КодКарты = &КодКарты";

	// код передаем параметром а не склеиваем в текст
	// так безопаснее и не будет инъекции в запрос
	Запрос.УстановитьПараметр("КодКарты", КодСотр);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// берем первую найденную запись
	// цикл тут нужен просто чтобы прочитать единственную строку выборки
	Пока Выборка.Следующий() Цикл
		Результат.Вставить("Пользователь", Выборка.Ссылка);
		Результат.Вставить("Сотрудник", Выборка.Сотрудник);
		Возврат Результат;
	КонецЦикла;

	// если никого не нашли возвращаем пустые значения
	// вызывающий код проверяет это через ЗначениеЗаполнено(Сотрудник)
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Сотрудник", Сотрудник);
	Возврат Результат;

КонецФункции


// проверяет есть ли у документа реквизит ID_Запроса
// нужен чтобы код не падал на конфигурациях где этого реквизита нет
// если реквизита нет то и защита от дублей просто не работает
// request_id генерирует фронт и шлет с каждым post чтобы повторная отправка не создавала второй документ
Функция ЕстьРеквизитIDЗапроса(ИмяДокумента)
	// в попытке потому что документа с таким именем может вообще не быть
	Попытка
		// достаем метаданные документа по имени из строки
		МетаданныеДок = Метаданные.Документы[ИмяДокумента];
		// если такого документа нет в конфигурации говорим что реквизита нет
		Если МетаданныеДок = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		// ищем реквизит по имени среди реквизитов шапки документа
		Возврат МетаданныеДок.Реквизиты.Найти("ID_Запроса") <> Неопределено;
	Исключение
		// любая ошибка значит что проверить не вышло поэтому считаем что реквизита нет
		Возврат Ложь;
	КонецПопытки;
КонецФункции


// возвращает текущий остаток долга по связке контрагент тро и торговая точка
// сейчас нигде не вызывается но может пригодиться
// знак тут как в регистре то есть долг хранится с минусом (смотри nomenclatureget)
Функция ДолгПоТочке(Контрагент, ТорговаяТочка, ТРО)
	// суммируем остаток по всем записям подходящим под три условия
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(КофеТТВзаиморасчетыОстатки.СуммаОстаток) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.КофеТТВзаиморасчеты.Остатки КАК КофеТТВзаиморасчетыОстатки
		|ГДЕ
		|	КофеТТВзаиморасчетыОстатки.Контрагент = &Контрагент
		|	И КофеТТВзаиморасчетыОстатки.ТРО = &ТРО
		|	И КофеТТВзаиморасчетыОстатки.ТорговаяТочка = &ТорговаяТочка";

	// все три измерения регистра передаем параметрами
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТорговаяТочка", ТорговаяТочка);
	Запрос.УстановитьПараметр("ТРО", ТРО);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// агрегат без группировки всегда дает одну строку
	// но сумма в ней может быть пустой (NULL) если записей нет
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.СуммаОстаток;
	КонецЦикла;

	// если вообще ничего нет то долг ноль
	Возврат 0;
КонецФункции


// пишет одно движение в регистр взаиморасчетов
// вид движения приход уменьшает долг а расход увеличивает
// регистратор это документ который породил движение
// вызывается из meters (расход) и payment (приход) внутри транзакции
Процедура ЗаписатьДвижениеДолга(Регистратор, ТочкаСсылка, Сумма, ВидДвижения)
	// без регистратора писать движение нельзя
	// в регистр накопления записи без документа основания не бывает
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат;
	КонецЕсли;

	// нулевая сумма не нужна
	// пустое движение только засоряет регистр
	Если Не ЗначениеЗаполнено(Сумма) ИЛИ Сумма = 0 Тогда
		Возврат;
	КонецЕсли;

	// создаем набор записей и привязываем его к документу регистратору
	// отбор по регистратору нужен чтобы при записи набор заменил только движения этого документа
	Набор = РегистрыНакопления.КофеТТВзаиморасчеты.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);

	// добавляем одну строку движения и заполняем все измерения и ресурс
	Движение = Набор.Добавить();
	// активность истина иначе движение не будет учитываться в остатках
	Движение.Активность    = Истина;
	Движение.ВидДвижения   = ВидДвижения;
	// период берем из даты документа чтобы остатки считались на нужное время
	Движение.Период        = Регистратор.Дата;
	Движение.Контрагент    = ТочкаСсылка.Контрагент;
	Движение.ТРО           = ТочкаСсылка.НоменклатураТРО;
	Движение.ТорговаяТочка = ТочкаСсылка;
	Движение.Сумма         = Сумма;

	// сама запись в базу
	Набор.Записать();
КонецПроцедуры


// заглушка для движений по количеству
// тело не реализовано так как эти движения делает сам документ
// оставлена чтобы не переписывать вызовы в orders если логика вернется сюда
Процедура ЗаписатьДвиженияКоличества(Регистратор, ТочкаСсылка, ТРОСсылка, МассивДвижений, ВидДвижения)
	// ничего не делаем
КонецПроцедуры


// перезаписывает движения документа перерасчета в регистре остатков аппаратов
// документ при проведении пишет движения без торговой точки
// из за этого запрос остатков по точке их не находит
// поэтому стираем такие движения и пишем правильные с заполненной точкой
// вызывается из POST_Recount сразу после проведения и в той же транзакции
Процедура ПерезаписатьДвиженияПерерасчета(Регистратор, ТочкаСсылка, ТРОСсылка, МассивПриход, МассивРасход)
	// без документа или без точки перезаписывать нечего
	Если Не ЗначениеЗаполнено(Регистратор) ИЛИ Не ЗначениеЗаполнено(ТочкаСсылка) Тогда
		Возврат;
	КонецЕсли;

	// набор записей регистра остатков аппаратов привязанный к документу
	Набор = РегистрыНакопления.КофейныеАппаратыОстатки.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Регистратор);
	// очищаем старые некорректные движения
	// набор пока только в памяти поэтому старые записи удалятся при Записать
	Набор.Очистить();

	// движения прихода это товар которого оказалось больше чем в учете
	// массив может быть неопределен если излишков не было
	Если МассивПриход <> Неопределено Тогда
		Для Каждого СтрДв Из МассивПриход Цикл
			// строки без товара пропускаем
			Если Не ЗначениеЗаполнено(СтрДв.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			// количество приводим к числу на всякий случай
			Кол = Число(СтрДв.Количество);
			// движение с нулем или минусом бессмысленно
			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			// пишем строку прихода уже с заполненной торговой точкой
			Дв = Набор.Добавить();
			Дв.Активность      = Истина;
			Дв.ВидДвижения     = ВидДвиженияНакопления.Приход;
			Дв.Период          = Регистратор.Дата;
			Дв.ТРО             = ТРОСсылка;
			Дв.ТорговаяТочка   = ТочкаСсылка;
			Дв.Номенклатура    = СтрДв.Номенклатура;
			Дв.Количество      = Кол;
		КонецЦикла;
	КонецЕсли;

	// движения расхода это недостача относительно учета
	Если МассивРасход <> Неопределено Тогда
		Для Каждого СтрДв Из МассивРасход Цикл
			// те же проверки что и для прихода
			Если Не ЗначениеЗаполнено(СтрДв.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			Кол = Число(СтрДв.Количество);
			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			// строка расхода тоже с точкой
			Дв = Набор.Добавить();
			Дв.Активность      = Истина;
			Дв.ВидДвижения     = ВидДвиженияНакопления.Расход;
			Дв.Период          = Регистратор.Дата;
			Дв.ТРО             = ТРОСсылка;
			Дв.ТорговаяТочка   = ТочкаСсылка;
			Дв.Номенклатура    = СтрДв.Номенклатура;
			Дв.Количество      = Кол;
		КонецЦикла;
	КонецЕсли;

	// записываем набор целиком
	// старые кривые движения исчезнут а новые правильные появятся
	Набор.Записать();
КонецПроцедуры


// ============================================================
// метод nomenclature (получение списка точек)
// возвращает точки с долгом блокировками и ассортиментом
// это главный экран приложения откуда идет все остальное
// ============================================================
Функция nomenclatureget(Запрос)
	// все в попытке чтобы любая ошибка вернулась на фронт текстом а не повисла
	Попытка
		// код сотрудника приходит в параметре u
		КодСотр = СокрЛП(Запрос.ПараметрыЗапроса.Получить("u"));

		// определяем кто спрашивает
		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;

		// если пин не нашелся дальше идти нельзя
		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// основной запрос по точкам
		// долг берется из регистра взаиморасчетов
		// три блокировки показывают были ли сегодня проведены документы по точке
		// блокировка нужна чтобы не вносить показания или заказ по точке дважды за день
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Точки.Ссылка КАК ТочкаСсылка,
		|	Точки.Код КАК id,
		|	Точки.Наименование КАК point_name,
		|	ЕСТЬNULL(Точки.Контрагент.Наименование, """") КАК counterparty,
		|	ЕСТЬNULL(Точки.Адрес, """") КАК address,
		|	ЕСТЬNULL(Точки.НоменклатураТРО.Наименование, """") КАК coffee_machine,
		|	ЕСТЬNULL(Точки.НоменклатураТРО.Код, """") КАК coffee_machine_code,
		|	Точки.НоменклатураТРО КАК ТРОСсылка,
		|	ЕСТЬNULL(ОстаткиДолга.СуммаОстаток, 0) КАК debt,
		|	ВЫБОР
		|		КОГДА БлокДок.Точка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК locked,
		|	БлокДок.Дата КАК locked_at,
		|	ВЫБОР
		|		КОГДА БлокЗаказ.Точка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК order_locked,
		|	БлокЗаказ.Дата КАК order_locked_at,
		|	ВЫБОР
		|		КОГДА БлокПерерасчет.Точка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК recount_locked,
		|	БлокПерерасчет.Дата КАК recount_locked_at
		|ИЗ
		|	Справочник.ТорговыеТочки КАК Точки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КофейныеАппаратыОстаткиОстатки.ТорговаяТочка КАК ТорговаяТочка,
		|			СУММА(КофейныеАппаратыОстаткиОстатки.СуммаОстаток) КАК СуммаОстаток
		|		ИЗ
		|			РегистрНакопления.КофеТТВзаиморасчеты.Остатки КАК КофейныеАппаратыОстаткиОстатки
		|		СГРУППИРОВАТЬ ПО
		|			КофейныеАппаратыОстаткиОстатки.ТорговаяТочка) КАК ОстаткиДолга
		|		ПО Точки.Ссылка = ОстаткиДолга.ТорговаяТочка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокТЧ.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокТЧ.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ДокТЧ
		|		ГДЕ
		|			ДокТЧ.Ссылка.Проведен
		|			И ДокТЧ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокТЧ.Ссылка.ТорговаяТочка) КАК БлокДок
		|		ПО Точки.Ссылка = БлокДок.Точка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокЗ.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокЗ.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыПополнениеЗапасов.Состав КАК ДокЗ
		|		ГДЕ
		|			ДокЗ.Ссылка.Проведен
		|			И ДокЗ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокЗ.Ссылка.ТорговаяТочка) КАК БлокЗаказ
		|		ПО Точки.Ссылка = БлокЗаказ.Точка
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ДокП.Ссылка.ТорговаяТочка КАК Точка,
		|			МАКСИМУМ(ДокП.Ссылка.Дата) КАК Дата
		|		ИЗ
		|			Документ.КофейныеАппаратыПерерахунок.Состав КАК ДокП
		|		ГДЕ
		|			ДокП.Ссылка.Проведен
		|			И ДокП.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)
		|		СГРУППИРОВАТЬ ПО
		|			ДокП.Ссылка.ТорговаяТочка) КАК БлокПерерасчет
		|		ПО Точки.Ссылка = БлокПерерасчет.Точка
		|ГДЕ
		|	Точки.ПометкаУдаления = ЛОЖЬ";

		// не администратор видит только свои точки
		// условие дописываем в конец текста запроса только для обычных сотрудников
		// символы пс это просто перенос строки чтобы текст не слипся
		Если Не Сотр.РольАдминистратора Тогда
			ТекстЗапроса = ТекстЗапроса
				+ Символы.ПС
				+ " И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
		КонецЕсли;

		// создаем запрос из собранного текста и задаем параметры
		// параметр основной менеджер лишний для админа но 1с на это не ругается
		ЗапросБД = Новый Запрос(ТекстЗапроса);
		ЗапросБД.УстановитьПараметр("ОсновнойМенеджер", Сотр.Ссылка);
		// текущая дата нужна для границ дня в блокировках
		ЗапросБД.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		Выборка = ЗапросБД.Выполнить().Выбрать();

		// собираем промежуточный массив и список точек
		// промежуточный нужен потому что счетчики мы достаем отдельным запросом по всем точкам сразу
		Промежуточные = Новый Массив;
		МассивТочек  = Новый Массив;

		Пока Выборка.Следующий() Цикл
			// складываем в структуру все поля строки выборки
			Стр = Новый Структура;
			Стр.Вставить("Точка",              Выборка.ТочкаСсылка);
			Стр.Вставить("id",                 Выборка.id);
			Стр.Вставить("point_name",         Выборка.point_name);
			Стр.Вставить("counterparty",       Выборка.counterparty);
			Стр.Вставить("address",            Выборка.address);
			Стр.Вставить("coffee_machine",     Выборка.coffee_machine);
			Стр.Вставить("coffee_machine_code",Выборка.coffee_machine_code);
			// в регистре долг хранится с обратным знаком поэтому умножаем на минус один
			Стр.Вставить("debt",               Выборка.debt * (-1));
			Стр.Вставить("locked",             Выборка.locked);
			Стр.Вставить("locked_at",          Выборка.locked_at);
			Стр.Вставить("order_locked",       Выборка.order_locked);
			Стр.Вставить("order_locked_at",    Выборка.order_locked_at);
			Стр.Вставить("recount_locked",     Выборка.recount_locked);
			Стр.Вставить("recount_locked_at",  Выборка.recount_locked_at);
			// ссылка на оборудование нужна ниже чтобы прочитать его ассортимент
			Стр.Вставить("ТРОСсылка",          Выборка.ТРОСсылка);
			Промежуточные.Добавить(Стр);

			// список точек уйдет параметром в запрос счетчиков
			Если ЗначениеЗаполнено(Выборка.ТочкаСсылка) Тогда
				МассивТочек.Добавить(Выборка.ТочкаСсылка);
			КонецЕсли;
		КонецЦикла;

		// одним запросом берем последние счетчики по всем точкам
		// ключ в соответствии это точка и номенклатура через вертикальную черту
		// значение это последнее проведенное показание счетчика
		// так быстрее чем дергать базу отдельно на каждую точку и каждый товар
		КартаСчетчиков = Новый Соответствие;

		Если МассивТочек.Количество() > 0 Тогда
			ЗапросСчетчиков = Новый Запрос;
			// сортировка по дате убывает чтобы самое свежее показание шло первым
			ЗапросСчетчиков.Текст =
			"ВЫБРАТЬ
			|	ТЧ.Ссылка.ТорговаяТочка КАК Точка,
			|	ТЧ.Номенклатура КАК Номенклатура,
			|	ТЧ.СчетчикТекущий КАК Счетчик,
			|	ТЧ.Ссылка.Дата КАК Дата
			|ИЗ
			|	Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ТЧ
			|ГДЕ
			|	ТЧ.Ссылка.Проведен
			|	И ТЧ.Ссылка.ТорговаяТочка В (&Точки)
			|УПОРЯДОЧИТЬ ПО
			|	Точка,
			|	Номенклатура,
			|	Дата УБЫВ";
			ЗапросСчетчиков.УстановитьПараметр("Точки", МассивТочек);

			ВыборкаСч = ЗапросСчетчиков.Выполнить().Выбрать();
			Пока ВыборкаСч.Следующий() Цикл
				// ключ строим из текстового представления точки и товара
				Ключ = Строка(ВыборкаСч.Точка) + "|" + Строка(ВыборкаСч.Номенклатура);
				// если по этому ключу уже есть значение то оно свежее и перезаписывать нельзя
				Если КартаСчетчиков[Ключ] = Неопределено Тогда
					// первое вхождение самое свежее так как сортировка по дате убывает
					КартаСчетчиков.Вставить(Ключ, Число(ВыборкаСч.Счетчик));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// формируем итоговый массив для ответа
		МассивДанных = Новый Массив;

		Для Каждого Стр Из Промежуточные Цикл
			// структура одной точки в том виде в котором ее ждет фронт
			СтрокаДанных = Новый Структура;
			СтрокаДанных.Вставить("id",                 Стр.id);
			СтрокаДанных.Вставить("point_name",         Стр.point_name);
			СтрокаДанных.Вставить("counterparty",       Стр.counterparty);
			СтрокаДанных.Вставить("address",            Стр.address);
			СтрокаДанных.Вставить("coffee_machine",     Стр.coffee_machine);
			СтрокаДанных.Вставить("coffee_machine_code",Стр.coffee_machine_code);
			СтрокаДанных.Вставить("debt",               Стр.debt);

			// время блокировки отдаем только если блокировка есть
			// формат длф=в дает только время без даты
			СтрокаДанных.Вставить("locked", Стр.locked);
			Если Стр.locked Тогда
				СтрокаДанных.Вставить("locked_at", Формат(Стр.locked_at, "ДЛФ=В"));
			КонецЕсли;

			// блокировка заказа пополнения
			СтрокаДанных.Вставить("order_locked", Стр.order_locked);
			Если Стр.order_locked Тогда
				СтрокаДанных.Вставить("order_locked_at", Формат(Стр.order_locked_at, "ДЛФ=В"));
			КонецЕсли;

			// блокировка перерасчета остатков
			СтрокаДанных.Вставить("recount_locked", Стр.recount_locked);
			Если Стр.recount_locked Тогда
				СтрокаДанных.Вставить("recount_locked_at", Формат(Стр.recount_locked_at, "ДЛФ=В"));
			КонецЕсли;

			// ассортимент берем из табличной части оборудования
			// заодно считаем общий счетчик как сумму последних показаний по всем позициям
			МассивАссортимента = Новый Массив;
			ОбщийСчетчик = 0;
			ИспользоватьОбщийСчетчик = Ложь;

			// если у точки не указано оборудование то ассортимент останется пустым
			Если ЗначениеЗаполнено(Стр.ТРОСсылка) Тогда
				// галочку читаем только если такой реквизит есть у оборудования
				// галочка значит что аппарат считает все напитки одним общим счетчиком
				Если Стр.ТРОСсылка.Метаданные().Реквизиты.Найти("ИспользоватьОбщийСчетчик") <> Неопределено Тогда
					ИспользоватьОбщийСчетчик = (Стр.ТРОСсылка.ИспользоватьОбщийСчетчик = Истина);
				КонецЕсли;

				// идем по строкам ассортимента оборудования
				Для Каждого СтрокаТЧ Из Стр.ТРОСсылка.АссортиментыПоТоварам Цикл
					// тот же ключ что и при заполнении карты счетчиков
					Ключ = Строка(Стр.Точка) + "|" + Строка(СтрокаТЧ.Номенклатура);

					// если показаний еще не было считаем что счетчик нулевой
					ПоследнийСчетчик = 0;
					Если КартаСчетчиков[Ключ] <> Неопределено Тогда
						ПоследнийСчетчик = КартаСчетчиков[Ключ];
					КонецЕсли;

					// копим сумму для режима общего счетчика
					ОбщийСчетчик = ОбщийСчетчик + ПоследнийСчетчик;

					// позиция ассортимента для фронта
					// last_meter это от чего фронт будет считать разницу при новом вводе
					СтруктураАссортимента = Новый Структура;
					СтруктураАссортимента.Вставить("code",       СтрокаТЧ.Номенклатура.Код);
					СтруктураАссортимента.Вставить("name",       СтрокаТЧ.Номенклатура.Наименование);
					СтруктураАссортимента.Вставить("price",      СтрокаТЧ.Цена);
					СтруктураАссортимента.Вставить("last_meter", ПоследнийСчетчик);
					МассивАссортимента.Добавить(СтруктураАссортимента);
				КонецЦикла;
			КонецЕсли;

			// флаг и значение общего счетчика для фронта
			// если режим выключен то отдаем ноль чтобы фронт не путался
			СтрокаДанных.Вставить("use_total_counter", ИспользоватьОбщийСчетчик);
			СтрокаДанных.Вставить("total_counter", ?(ИспользоватьОбщийСчетчик, ОбщийСчетчик, 0));

			СтрокаДанных.Вставить("assortment", МассивАссортимента);
			МассивДанных.Добавить(СтрокаДанных);
		КонецЦикла;

		// сериализуем в json
		// запись json в строку а не в файл
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		// успешный ответ с заголовками для cors
		// cors нужен потому что фронт открыт с другого адреса чем 1с
		// ngrok-skip-browser-warning нужен чтобы ngrok не подсовывал свою страницу предупреждения
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		// ответ с ошибкой тоже содержит заголовок cors иначе браузер скроет текст ошибки
		// 500 потому что это сбой на стороне сервера
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("Помилка 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода nomenclature
// браузер сам шлет options перед get с кастомными заголовками и ждет разрешения
// тела тут нет только заголовки с разрешениями
Функция nomenclatureoptions(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции

//--- Поиск точки
// ============================================================
// метод meters (внесение показаний счетчиков)
// создает документ обслуживания и записывает движение долга
// сумма долга считается как разница счетчиков умноженная на цену
// ============================================================
Функция POST_Meters(Запрос)
	Попытка
		// читаем тело запроса как json
		// фронт шлет json строкой в теле post
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		// достаем основные поля запроса
		// point_id это код точки meters это массив строк по товарам technician_id это пин
		КодТочки = Данные.point_id;
		МассивСтрок = Данные.meters;
		КодСотр = Данные.technician_id;

		// request_id необязательный поэтому читаем через свойство
		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если в конфигурации есть реквизит ID_Запроса)
		// если запрос с таким id уже обработан то второй документ не создаем
		ЕстьIDЗапроса = ЕстьРеквизитIDЗапроса("КофейныеАппаратыОбслуживание");
		Если ЕстьIDЗапроса И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КофейныеАппаратыОбслуживание ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				// отвечаем успехом чтобы фронт считал что все сохранилось и не слал повторно
				// сумма тут ноль потому что настоящую мы уже не пересчитываем
				Результат = Новый Структура("ok, sum, debt_error, stock_error", Истина, 0, "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат); СтрокаJSON = ЗаписьJSON.Закрыть();
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		// определяем сотрудника и пользователя по пину
		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		// сотрудник должен существовать
		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// ищем точку по коду
		// пустая ссылка значит что такого кода в справочнике нет
		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(КодТочки);
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена!.";
		КонецЕсли;

		// не администратор не может вносить показания по точке дважды за день
		// админу можно чтобы исправлять ошибки
		Если Не Сотр.РольАдминистратора Тогда
			// ищем любой проведенный сегодня документ обслуживания по этой точке
			ЗапросПроверки = Новый Запрос;
			ЗапросПроверки.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДокТЧ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.КофейныеАппаратыОбслуживание.Ассортимент КАК ДокТЧ
			|ГДЕ
			|	ДокТЧ.Ссылка.Проведен
			|	И ДокТЧ.Ссылка.ТорговаяТочка = &ТорговаяТочка
			|	И ДокТЧ.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&ТекущаяДата, ДЕНЬ)";
			ЗапросПроверки.УстановитьПараметр("ТорговаяТочка", ТочкаСсылка);
			ЗапросПроверки.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

			Если Не ЗапросПроверки.Выполнить().Пустой() Тогда
				// код 409 означает что показания уже внесены
				// фронт по этому коду показывает понятное сообщение
				Ответ = Новый HTTPСервисОтвет(409);
				Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
				Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
				Ответ.УстановитьТелоИзСтроки("Показники по цій точці вже внесені сьогодні.", КодировкаТекста.UTF8);
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		// готовим документ обслуживания (пока без записи в базу)
		// заполняем шапку из точки и пользователя
		НовыйДок = Документы.КофейныеАппаратыОбслуживание.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.Автор = Пользователь;
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО = ТочкаСсылка.НоменклатураТРО;
		
		// ID_Запроса пишем только если реквизит существует в конфигурации
		// в попытке на случай если запись реквизита все равно не удалась
		Если ЕстьIDЗапроса Тогда
			Попытка НовыйДок.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		// получаем объект оборудования чтобы читать его табличную часть с ассортиментом
		ОборудованиеОбъект = ТочкаСсылка.НоменклатураТРО.ПолучитьОбъект();

		// ищем запасную технологическую карту на случай если у позиции своей нет
		// сначала берем первую заполненную карту из ассортимента оборудования
		РезКалькуляция = Неопределено;
		Если ОборудованиеОбъект <> Неопределено И ОборудованиеОбъект.АссортиментыПоТоварам.Количество() > 0 Тогда
			Для Каждого СтрОбор Из ОборудованиеОбъект.АссортиментыПоТоварам Цикл
				Если ЗначениеЗаполнено(СтрОбор.ТехнологическаяКарта) Тогда
					РезКалькуляция = СтрОбор.ТехнологическаяКарта;
					// нашли первую заполненную и хватит
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// раньше тут был fallback на первую попавшуюся калькуляцию из базы
		// но это тихо портило себестоимость
		// поэтому теперь если карт нет вообще просто падаем с понятной ошибкой
		Если Не ЗначениеЗаполнено(РезКалькуляция) Тогда
			ВызватьИсключение
				"Для жодної позиції в асортименті обладнання не вказано технологічну карту. "
				+ "Заповніть карти в 1С перед зняттям показників.";
		КонецЕсли;

		// общая сумма продаж по всем строкам станет суммой долга
		СуммаОбщая = 0;

		// заполняем табличную часть по строкам из запроса
		Для Каждого Стр Из МассивСтрок Цикл
			// для каждой строки с фронта добавляем строку в табличную часть документа
			НоваяТЧ = НовыйДок.Ассортимент.Добавить();

			// ищем строго по коду, для совместимости пробуем по имени
			// свойства читаем через проверку потому что фронт мог не прислать одно из них
			КодТовара = ""; Если Стр.Свойство("code") Тогда КодТовара = СокрЛП(Стр.code); КонецЕсли;
			ИмяТовара = ""; Если Стр.Свойство("name") Тогда ИмяТовара = СокрЛП(Стр.name); КонецЕсли;

			// сначала пустая ссылка потом пробуем найти настоящую
			ЭлементНоменклатуры = Справочники.Номенклатура.ПустаяСсылка();
			Если Не ПустаяСтрока(КодТовара) Тогда
				// поиск по коду может упасть если код не того формата поэтому в попытке
				Попытка ЭлементНоменклатуры = Справочники.Номенклатура.НайтиПоКоду(КодТовара); Исключение КонецПопытки;
			КонецЕсли;
			// если по коду не нашли то ищем по имени
			Если ЭлементНоменклатуры.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				ЭлементНоменклатуры = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;

			// предыдущий счетчик по умолчанию нулевой
			ПрошлыйСчетчик = 0;
			ЦенаИзБазы = 0;

			// если товар вообще нашли то заполняем номенклатуру и подтягиваем цену и карту
			Если Не ЭлементНоменклатуры.Пустая() Тогда
				НоваяТЧ.Номенклатура = ЭлементНоменклатуры;

				НайденнаяКарта = Неопределено;

				// ищем эту позицию в ассортименте оборудования
				// чтобы взять ее технологическую карту
				Если ОборудованиеОбъект <> Неопределено Тогда
					Для Каждого СтрОборудования Из ОборудованиеОбъект.АссортиментыПоТоварам Цикл
						Если СтрОборудования.Номенклатура = ЭлементНоменклатуры Тогда
							НайденнаяКарта = СтрОборудования.ТехнологическаяКарта;
							// прошлый счетчик равен текущему минус дельта
							// фронт передает оба значения
							ПрошлыйСчетчик = Стр.value - Стр.delta;
							// цену берем из базы а не с фронта чтобы ее нельзя было подменить
							ЦенаИзБазы = СтрОборудования.Цена;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;

				// если у позиции нет своей карты берем запасную
				Если Не ЗначениеЗаполнено(НайденнаяКарта) Тогда
					НайденнаяКарта = РезКалькуляция;
				КонецЕсли;

				Если ЗначениеЗаполнено(НайденнаяКарта) Тогда
					НоваяТЧ.ТехнологическаяКарта = НайденнаяКарта;
				КонецЕсли;
			КонецЕсли;

			// заполняем числовые поля строки
			// value это текущее показание счетчика а delta сколько налито с прошлого раза
			НоваяТЧ.Счетчик = ПрошлыйСчетчик;
			НоваяТЧ.Цена = ЦенаИзБазы;
			НоваяТЧ.СчетчикТекущий = Стр.value;
			НоваяТЧ.Количество = Стр.delta;
			НоваяТЧ.Сумма = Стр.delta * ЦенаИзБазы; // рассчитываем сумму на сервере

			// копим общую сумму по документу
			СуммаОбщая = СуммаОбщая + НоваяТЧ.Сумма;
		КонецЦикла;

		// записываем сумму в шапку если такой реквизит есть
		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаОбщая;
		КонецЕсли;

		// документ и движение долга пишутся в одной транзакции
		// если что то упадет откатится все и клиент получит ошибку
		// иначе можно получить документ без долга или долг без документа
		НачатьТранзакцию();
		Попытка
			// проведение сразу пишет все движения самого документа
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);

			// показатели увеличивают долг поэтому вид движения расход
			ЗаписатьДвижениеДолга(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				СуммаОбщая,
				ВидДвиженияНакопления.Расход
			);

			ЗафиксироватьТранзакцию();
		Исключение
			// текст ошибки запоминаем до отмены транзакции пока он не потерялся
			ТекстОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			// пишем в журнал регистрации чтобы потом можно было разобраться
			ЗаписьЖурналаРегистрации("КофеПриложение.Показатели", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстОшибки);
			ВызватьИсключение "Показники не збережено: " + ТекстОшибки;
		КонецПопытки;

		// поля с ошибками оставляем пустыми чтобы фронт не сломался
		// фронт ждет эти поля и без них может упасть
		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("sum", СуммаОбщая);
		Результат.Вставить("debt_error", "");
		Результат.Вставить("stock_error", "");

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		// успешный ответ с заголовками cors как везде
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		// любая ошибка выше (в том числе вызванное исключение) попадает сюда
		// отдаем 400 с текстом ошибки чтобы фронт показал его пользователю
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода meters
// просто разрешаем post с нашими заголовками
Функция OPTIONS_Meters(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции


// ============================================================
// метод payment (оплата долга)
// создает приходный кассовый ордер и документ погашения долга
// первый документ это деньги в кассе второй это уменьшение долга точки
// ============================================================
Функция POST_Payment(Запрос)
	Попытка
		// читаем json из тела запроса
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		// amount это сумма которую заплатили
		КодТочки = Данные.point_id;
		КодСотр  = Данные.technician_id;
		Сумма    = Число(Данные.amount);
		
		// id запроса для защиты от дублей
		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если у ПКО есть реквизит ID_Запроса)
		// проверяем только по пко потому что документ погашения всегда создается вместе с ним
		ЕстьIDПКО = ЕстьРеквизитIDЗапроса("ПКО");
		Если ЕстьIDПКО И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ПКО ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				// уже обработано отвечаем успехом с пустыми номером и датой
				Результат = Новый Структура("ok, doc_number, doc_date, conduct_error", Истина, "", "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат);
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		// кто платит
		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// значения по умолчанию берем из настроек пользователя
		// касса нужна только тут потому что деньги принимаются наличными
		ОсновнойМагазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
		ОсновнаяКасса = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяКасса");
		ОсновнаяОрганизация = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяОрганизация");

		// сумма оплаты должна быть положительной иначе это бессмыслица
		Если Сумма <= 0 Тогда
			ВызватьИсключение "Сума оплати має бути більше нуля.";
		КонецЕсли;

		// ищем точку
		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// готовим приходный кассовый ордер (пока без записи в базу)
		ПКО = Документы.ПКО.СоздатьДокумент();
		ПКО.Дата = ТекущаяДата();
		ПКО.Организация = ОсновнаяОрганизация;
		ПКО.Магазин = ОсновнойМагазин;
		ПКО.Касса = ОсновнаяКасса;
		// вид операции оплата покупателя чтобы проводки пошли как за оплату
		ПКО.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;

		Если ЕстьIDПКО Тогда
			Попытка ПКО.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		// реквизиты которых может не быть в конфигурации заполняем в попытке
		// если реквизита нет то ошибка проглатывается и документ все равно создастся
		Попытка
			ПКО.Контрагент = ТочкаСсылка.Контрагент;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Сумма = Сумма;
		Исключение
		КонецПопытки;

		// ндс нет потому что это оплата долга а не продажа
		Попытка
			ПКО.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Автор = Пользователь;
		Исключение
		КонецПопытки;

		// от кого приняли деньги пишем имя сотрудника
		Попытка
			ПКО.ПринятоОт = Сотр.Наименование;
		Исключение
		КонецПопытки;

		Попытка
			ПКО.Менеджер = Сотр;
		Исключение
		КонецПопытки;

		// комментарий чтобы в 1с было видно что оплата пришла из приложения
		Попытка
			ПКО.Комментарий = "Оплата боргу через мобільний додаток ("
				+ СокрЛП(ТочкаСсылка.Наименование) + ")";
		Исключение
		КонецПопытки;

		// готовим документ погашения долга
		// он уменьшает долг по конкретной точке
		Док = Документы.КофейныеАппаратыПогашениеДолга.СоздатьДокумент();
		Док.Дата = ТекущаяДата();
		Док.Автор = Пользователь;
		Док.Организация = ОсновнаяОрганизация;
		Док.Магазин = ОсновнойМагазин;
		Док.Контрагент = ТочкаСсылка.Контрагент;
		Док.ТРО = ТочкаСсылка.НоменклатураТРО;
		Док.ТорговаяТочка = ТочкаСсылка;
		Док.Сумма = Сумма;

		// для второго документа используем другой ID
		// чтобы уникальность не сработала на ПКО и погашении сразу
		// пишем только если реквизит существует
		// суффикс -d от слова долг
		Если ЕстьРеквизитIDЗапроса("КофейныеАппаратыПогашениеДолга") Тогда
			Попытка Док.ID_Запроса = RequestID + "-d"; Исключение КонецПопытки;
		КонецЕсли;

		// все что пишет в базу идет в одной транзакции
		// иначе можно получить деньги в кассе без уменьшения долга
		НачатьТранзакцию();
		Попытка
			// сначала деньги в кассу потом погашение
			ПКО.Записать(РежимЗаписиДокумента.Проведение);
			Док.Записать(РежимЗаписиДокумента.Проведение);

			// оплата уменьшает долг поэтому вид движения приход
			// регистратором ставим документ погашения а не пко
			ЗаписатьДвижениеДолга(
				Док.Ссылка,
				ТочкаСсылка,
				Сумма,
				ВидДвиженияНакопления.Приход
			);

			ЗафиксироватьТранзакцию();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("КофеПриложение.Оплата", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстОшибки);
			ВызватьИсключение "Оплату не проведено: " + ТекстОшибки;
		КонецПопытки;

		// пустое поле conduct_error означает для фронта что все прошло успешно
		// номер и дату отдаем от пко потому что именно его человек увидит в кассе
		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(ПКО.Номер));
		Результат.Вставить("doc_date",      Формат(ПКО.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("conduct_error", "");

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		// общий обработчик ошибок метода как в meters
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода payment
Функция OPTIONS_Payment(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции


// ============================================================
// метод login (вход по пин коду)
// фронт шлет pin а в ответ получает имя и признак админа
// ============================================================
Функция POST_login(Запрос)
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();

	// пустое тело это неверный запрос
	// отвечаем 400 без тела
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Возврат Ответ;
	КонецЕсли;

	// разбираем json и достаем pin
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	ПинКод = ДанныеЗапроса.pin;
	// вся логика проверки вынесена в отдельную функцию которая сразу возвращает готовый json
	РезультатJSON = АвторизоватьПользователя(ПинКод);

	// здесь всегда 200 даже если пин неверный
	// неверный пин фронт узнает по полю code равному нулю
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, X-User-Code, ngrok-skip-browser-warning");
	Ответ.УстановитьТелоИзСтроки(РезультатJSON, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции


// ответ на предварительный запрос браузера options для метода login
Функция OPTIONS_login(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции


// проверяет пин код и возвращает json с именем и признаком администратора
// если пользователь не найден возвращается код ноль и имя не найдено
// эту функцию написал начальник поэтому формат полей code name isadmin с большой буквы
Функция АвторизоватьПользователя(КодАвторизации)
	Данные = Новый Структура;

	// пустой пин сразу отбиваем
	Если ПустаяСтрока(КодАвторизации) Тогда
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		Данные.Вставить("IsAdmin", Ложь);
	Иначе
		// ищем неудаленного пользователя с таким кодом карты
		// если реквизит администратора пустой то считаем что не админ
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.КодКарты КАК КодКарты,
		|	Пользователи.Сотрудник.Наименование КАК Имя,
		|	ЕСТЬNULL(Пользователи.Сотрудник.РольАдминистратора, ЛОЖЬ) КАК РольАдминистратора
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.КодКарты = &Код
		|	И НЕ Пользователи.ПометкаУдаления";
		Запрос.УстановитьПараметр("Код", СокрЛП(КодАвторизации));
		Выборка = Запрос.Выполнить().Выбрать();

		// нашли пользователя отдаем его данные
		Если Выборка.Следующий() Тогда
			Данные.Вставить("Code", СокрЛП(Выборка.КодКарты));
			Данные.Вставить("Name", Выборка.Имя);
			Данные.Вставить("IsAdmin", Выборка.РольАдминистратора);
		Иначе
			// не нашли значит пин неверный или пользователь удален
			Данные.Вставить("Code", "0");
			Данные.Вставить("Name", "НЕ ЗНАЙДЕНО");
			Данные.Вставить("IsAdmin", Ложь);
		КонецЕсли;
	КонецЕсли;

	// превращаем структуру в json строку и возвращаем
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// ============================================================
// метод assortments (ассортимент пополнения для точки)
// фронт зовет его когда человек открывает экран заказа
// ============================================================
Функция assortmentsget(Запрос)
	Попытка
		// код точки приходит в параметре point
		КодТочки = Запрос.ПараметрыЗапроса.Получить("point");
		// вся работа в отдельной функции которая возвращает готовую json строку
		СтрокаJSON = ВернутьАсортимент(КодТочки);

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.УстановитьТелоИзСтроки("Помилка 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


