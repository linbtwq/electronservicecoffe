// возвращает json с учетными остатками и ценами для перерасчета
// цена берется из ассортимента пополнения по коду номенклатуры
// book это сколько должно быть по учету а actual введет человек на фронте
Функция ВернутьПерерасчет(КодТТ)
	// пустой код точки
	Если ПустаяСтрока(СокрЛП(КодТТ)) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	ТТОбъект = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТТ));

	// точка не найдена
	Если НЕ ЗначениеЗаполнено(ТТОбъект) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Торгова точка не знайдена");
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	НоменклатураТРО = ТТОбъект.НоменклатураТРО;

	// у точки не указано оборудование
	Если НЕ ЗначениеЗаполнено(НоменклатураТРО) Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "ТРО не вказано");
		МассивДанных = Новый Массив;
		МассивДанных.Добавить(Данные);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивДанных);
		Возврат ЗаписьJSON.Закрыть();
	КонецЕсли;

	// учетные остатки по точке
	// тот же запрос что и в методе stock
	ЗапросОстатки = Новый Запрос;
		ЗапросОстатки.Текст =
	"ВЫБРАТЬ
	|  СУММА(КофейныеАппаратыОстаткиОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура КАК Номенклатура,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Код КАК Код,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Наименование КАК Наименование
	|ИЗ
	|  РегистрНакопления.КофейныеАппаратыОстатки.Остатки КАК КофейныеАппаратыОстаткиОстатки
	|ГДЕ
	|  КофейныеАппаратыОстаткиОстатки.ТРО = &ТРО
	|  И КофейныеАппаратыОстаткиОстатки.ТорговаяТочка = &ТорговаяТочка
	|СГРУППИРОВАТЬ ПО
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Код,
	|  КофейныеАппаратыОстаткиОстатки.Номенклатура.Наименование";

	ЗапросОстатки.УстановитьПараметр("ТРО", НоменклатураТРО);
	ЗапросОстатки.УстановитьПараметр("ТорговаяТочка", ТТОбъект);
	
	Выборка = ЗапросОстатки.Выполнить().Выбрать();
	
	// собираем товары и ищем цены по правильному регистру
	МассивТоваров = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивТоваров.Добавить(Выборка.Номенклатура);
	КонецЦикла;
	Цены = ТоварыЦены(МассивТоваров);

	// убираем старую логику с КартаЦен и берем из регистра
	Выборка.Сбросить();
	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		КодТовара = СокрЛП(Выборка.Код);

		Цена = Цены[Выборка.Номенклатура];
		Если Цена = Неопределено Тогда
			Цена = 0;
		КонецЕсли;

		Данные = Новый Структура;
		Данные.Вставить("Code", КодТовара);
		Данные.Вставить("Name", Выборка.Наименование);
		Данные.Вставить("price", Цена);
		Данные.Вставить("book", Выборка.КоличествоОстаток);
		Данные.Вставить("quantity", Выборка.КоличествоОстаток);

		МассивДанных.Добавить(Данные);
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// сохраняет результат перерасчета остатков
// сравнивает фактическое количество с учетным и пишет разницу
// положительная разница идет в приход а отрицательная в расход
// то есть излишек добавляет в учет а недостача списывает
Функция POST_Recount(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки    = Данные.point_id;
		КодСотр     = Данные.technician_id;
		МассивСтрок = Данные.items;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей (только если у документа есть реквизит ID_Запроса)
		ЕстьIDПерерасчета = ЕстьРеквизитIDЗапроса("КофейныеАппаратыПерерахунок");
		Если ЕстьIDПерерасчета И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КофейныеАппаратыПерерахунок ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				Результат = Новый Структура("ok, doc_number, doc_date, sum, stock_error, conduct_error", Истина, "", "", 0, "", "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат);
				Ответ = Новый HTTPСервисОтвет(200); Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8"); Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*"); Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8); Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// значения по умолчанию для пользователя как в заказе и оплате
		ОсновнойМагазин      = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
		ОсновнаяОрганизация  = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяОрганизация");

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// не администратор работает только со своими точками
		Если Не Сотр.РольАдминистратора Тогда
			ЗапросДоступ = Новый Запрос;
			ЗапросДоступ.Текст =
			"ВЫБРАТЬ
			|	Точки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТорговыеТочки КАК Точки
			|ГДЕ
			|	Точки.Ссылка = &Точка
			|	И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
			ЗапросДоступ.УстановитьПараметр("Точка", ТочкаСсылка);
			ЗапросДоступ.УстановитьПараметр("ОсновнойМенеджер", Сотр);
			Если ЗапросДоступ.Выполнить().Пустой() Тогда
				ВызватьИсключение "Немає доступу до цієї точки.";
			КонецЕсли;
		КонецЕсли;

		Если МассивСтрок = Неопределено ИЛИ МассивСтрок.Количество() = 0 Тогда
			ВызватьИсключение "Порожній склад перерахунку.";
		КонецЕсли;

		// создаем документ перерасчета и заполняем шапку
		НовыйДок = Документы.КофейныеАппаратыПерерахунок.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.ТорговаяТочка = ТочкаСсылка;
		НовыйДок.Контрагент    = ТочкаСсылка.Контрагент;
		НовыйДок.ТРО           = ТочкаСсылка.НоменклатураТРО;
		
		Если ЕстьIDПерерасчета Тогда
			Попытка НовыйДок.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		// организация и магазин обязательны для проведения на большинстве конфигураций
		// в попытке потому что в нашей версии этих реквизитов может не быть
		Попытка
			НовыйДок.Организация = ОсновнаяОрганизация;
		Исключение
		КонецПопытки;

		Попытка
			НовыйДок.Магазин = ОсновнойМагазин;
		Исключение
		КонецПопытки;

		Если НовыйДок.Метаданные().Реквизиты.Найти("Автор") <> Неопределено Тогда
			НовыйДок.Автор = Пользователь;
		КонецЕсли;

		// сумма отклонений в деньгах и два массива для регистра остатков
		СуммаПроданойПродукции = 0;
		МассивПриход = Новый Массив;
		МассивРасход = Новый Массив;

		// разбираем строки перерасчета
		Для Каждого Стр Из МассивСтрок Цикл
			КодТовара = "";
			Если Стр.Свойство("code") Тогда
				КодТовара = СокрЛП(Стр.code);
			КонецЕсли;

			ИмяТовара = "";
			Если Стр.Свойство("name") Тогда
				ИмяТовара = СокрЛП(Стр.name);
			КонецЕсли;

			Цена = 0;
			Если Стр.Свойство("price") Тогда
				Цена = Число(Стр.price);
			КонецЕсли;

			// учет это количество по данным базы
			Учет = 0;
			Если Стр.Свойство("book") Тогда
				Учет = Число(Стр.book);
			КонецЕсли;

			// факт это количество насчитанное на месте
			Факт = 0;
			Если Стр.Свойство("actual") Тогда
				Факт = Число(Стр.actual);
			КонецЕсли;

			// отклонение больше нуля значит излишек меньше нуля значит недостача
			Отклонение = Факт - Учет;

			// ищем товар по коду а потом по наименованию
			Товар = Справочники.Номенклатура.ПустаяСсылка();
			Если Не ПустаяСтрока(КодТовара) Тогда
				Попытка
					Товар = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если Товар.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				Товар = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;
			Если Товар.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			// отклонение в деньгах
			СуммаОтклонения = Отклонение * Цена;
			СуммаПроданойПродукции = СуммаПроданойПродукции + СуммаОтклонения;

			НоваяСтр = НовыйДок.Состав.Добавить();
			НоваяСтр.Номенклатура = Товар;

			// реквизиты строки могут отличаться в разных версиях конфигурации
			// поэтому каждый пишем отдельно в попытке
			Попытка
				НоваяСтр.УчетноеКоличество = Учет;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.Цена = Цена;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.СуммаОтклонения = СуммаОтклонения;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.ФактическоеКоличество = Факт;
			Исключение
			КонецПопытки;
			Попытка
				НоваяСтр.Отклонение = Отклонение;
			Исключение
			КонецПопытки;

			// отклонение раскладываем по массивам прихода и расхода
			// количество в движении всегда положительное
			// если отклонения нет то и движение писать не надо
			Если Отклонение <> 0 Тогда
				СтрДв = Новый Структура;
				СтрДв.Вставить("Номенклатура", Товар);
				// для недостачи меняем знак чтобы количество стало положительным
				СтрДв.Вставить("Количество", ?(Отклонение > 0, Отклонение, -Отклонение));

				Если Отклонение > 0 Тогда
					МассивПриход.Добавить(СтрДв);
				Иначе
					МассивРасход.Добавить(СтрДв);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		// если ни одной строки не прошло то документ пустой
		Если НовыйДок.Состав.Количество() = 0 Тогда
			ВызватьИсключение "Жодна позиція перерахунку не знайдена в номенклатурі.";
		КонецЕсли;

		Если НовыйДок.Метаданные().Реквизиты.Найти("СуммаПроданойПродукции") <> Неопределено Тогда
			НовыйДок.СуммаПроданойПродукции = СуммаПроданойПродукции;
		КонецЕсли;

		// проведение документа и перезапись движений идут в одной транзакции
		// документ при проведении пишет движения без торговой точки
		// из за этого запрос остатков по точке их не находит
		// поэтому сразу после проведения стираем кривые движения и пишем правильные
		НачатьТранзакцию();
		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);

			// подменяем кривые движения документа правильными
			ПерезаписатьДвиженияПерерасчета(
				НовыйДок.Ссылка,
				ТочкаСсылка,
				ТочкаСсылка.НоменклатураТРО,
				МассивПриход,
				МассивРасход
			);

			ЗафиксироватьТранзакцию();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("КофеПриложение.Перерасчет", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстОшибки);
			ВызватьИсключение "Перерахунок не збережено: " + ТекстОшибки;
		КонецПопытки;

		// поля с ошибками оставляем пустыми чтобы фронт не сломался
		// если бы что то упало мы бы уже вылетели в исключение выше
		ОшибкаПроведения = "";
		ОшибкаКоличества = "";

		// формируем ответ
		Результат = Новый Структура;
		Результат.Вставить("ok",            Истина);
		Результат.Вставить("doc_number",    СокрЛП(НовыйДок.Номер));
		Результат.Вставить("doc_date",      Формат(НовыйДок.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("sum",           СуммаПроданойПродукции);
		Результат.Вставить("stock_error",   ОшибкаКоличества);
		Результат.Вставить("conduct_error", ОшибкаПроведения);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции


// ============================================================
// метод notes (примітки по точці)
// get отдает историю заметок а post добавляет новую
// заметки хранятся в справочнике заметок точек
// ============================================================

// проверяет что сотрудник может работать с точкой
// админ может с любой а обычный сотрудник только с теми где он основной менеджер
Функция ДоступКТочкеРазрешен(Сотр, ТочкаСсылка)
	
	// админу можно все
	Если Сотр.РольАдминистратора Тогда
		Возврат Истина;
	КонецЕсли;

	// для остальных ищем точку с таким основным менеджером
	ЗапросДоступ = Новый Запрос;
	ЗапросДоступ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Точки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТорговыеТочки КАК Точки
	|ГДЕ
	|	Точки.Ссылка = &Точка
	|	И Точки.ОсновнойМенеджер = &ОсновнойМенеджер";
	ЗапросДоступ.УстановитьПараметр("Точка", ТочкаСсылка);
	ЗапросДоступ.УстановитьПараметр("ОсновнойМенеджер", Сотр);

	// запрос не пустой значит доступ есть
	Возврат Не ЗапросДоступ.Выполнить().Пустой();
	
КонецФункции


// собирает ответ с заголовками для cors
// чтобы не копировать одни и те же строки заголовков в каждый ответ метода notes
// json или простой текст (для ошибок) выбирается последним параметром
Функция ЗаметкиОтвет(КодОтвета, Тело, Методы, ЭтоJSON = Истина)
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", ?(ЭтоJSON, "application/json; charset=utf-8", "text/plain; charset=utf-8"));
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", Методы);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции


// превращает структуру или массив в строку json
Функция ЗаметкиВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// имя автора заметки для показа в истории
// сначала пробуем имя сотрудника а если его нет то имя самого пользователя
Функция ИмяАвтораЗаметки(Автор)
	// автор мог быть не заполнен у старых заметок
	Если Не ЗначениеЗаполнено(Автор) Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(Автор.Сотрудник) Тогда
		Возврат СокрЛП(Автор.Сотрудник.Наименование);
	КонецЕсли;

	Возврат СокрЛП(Автор.Наименование);
КонецФункции


// структура одной заметки в формате для фронта
// id это уникальный идентификатор элемента справочника в виде строки
Функция СтруктураЗаметки(Элемент)
	Заметка = Новый Структура;
	Заметка.Вставить("id",     Строка(Элемент.УникальныйИдентификатор()));
	Заметка.Вставить("author", ИмяАвтораЗаметки(Элемент.Автор));
	Заметка.Вставить("date",   Формат(Элемент.ДатаЗаметки, "ДФ=yyyy-MM-dd HH:mm:ss"));
	// метка это тип заметки (access service broken other)
	Заметка.Вставить("tag",    СокрЛП(Элемент.Метка));
	Заметка.Вставить("text",   Элемент.ТекстЗаметки);
	Возврат Заметка;
КонецФункции


// история заметок по точке от новых к старым
// отдаем максимум 50 последних чтобы ответ не раздувался
Функция notesget(Запрос)
	Методы = "GET, OPTIONS";
	Попытка
		// параметр u это пин сотрудника а point код точки
		// если параметра нет то подставляем пустую строку чтобы дальше не падало
		КодСотр = Запрос.ПараметрыЗапроса.Получить("u");
		Если КодСотр = Неопределено Тогда
			КодСотр = "";
		КонецЕсли;

		КодТочки = Запрос.ПараметрыЗапроса.Получить("point");
		Если КодТочки = Неопределено Тогда
			КодТочки = "";
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// чужие заметки смотреть нельзя
		Если Не ДоступКТочкеРазрешен(Сотр, ТочкаСсылка) Тогда
			ВызватьИсключение "Немає доступу до цієї точки.";
		КонецЕсли;

		// берем не удаленные заметки точки самые новые сверху
		ЗапросЗаметок = Новый Запрос;
		ЗапросЗаметок.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	Заметки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТорговыеТочкиЗаметки КАК Заметки
		|ГДЕ
		|	Заметки.ТорговаяТочка = &Точка
		|	И НЕ Заметки.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Заметки.ДатаЗаметки УБЫВ";
		ЗапросЗаметок.УстановитьПараметр("Точка", ТочкаСсылка);

		// каждую найденную заметку превращаем в структуру для фронта
		МассивДанных = Новый Массив;
		Выборка = ЗапросЗаметок.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивДанных.Добавить(СтруктураЗаметки(Выборка.Ссылка));
		КонецЦикла;

		Возврат ЗаметкиОтвет(200, ЗаметкиВJSON(МассивДанных), Методы);

	Исключение
		// краткое представление ошибки читается лучше чем полное с модулями и строками
		Возврат ЗаметкиОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции


// добавляет новую заметку
// повторный запрос с тем же идентификатором возвращает уже созданную заметку
// это защита от двойного нажатия кнопки и от повторной отправки при плохой связи
Функция POST_Notes(Запрос)
	Методы = "POST, OPTIONS";
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		// все приводим к строке и режем пробелы чтобы число или пробел не ломали поиск
		КодТочки = СокрЛП(Строка(Данные.point_id));
		КодСотр  = Данные.technician_id;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = СокрЛП(Строка(Данные.request_id));
		КонецЕсли;

		ТекстЗаметки = "";
		Если Данные.Свойство("text") Тогда
			ТекстЗаметки = СокрЛП(Строка(Данные.text));
		КонецЕсли;

		// метка допустима только из известного списка иначе остается пустой
		// так в базу не попадет случайный мусор с фронта
		Метка = "";
		Если Данные.Свойство("tag") Тогда
			Метка = СокрЛП(Строка(Данные.tag));
		КонецЕсли;
		Если Метка <> "access" И Метка <> "service" И Метка <> "broken" И Метка <> "other" Тогда
			Метка = "";
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		// пустую заметку не сохраняем
		Если ПустаяСтрока(ТекстЗаметки) Тогда
			ВызватьИсключение "Примітка порожня.";
		КонецЕсли;

		// ограничение длины такое же как на фронте
		Если СтрДлина(ТекстЗаметки) > 500 Тогда
			ВызватьИсключение "Примітка задовга, максимум 500 символів.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(КодТочки);
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		Если Не ДоступКТочкеРазрешен(Сотр, ТочкаСсылка) Тогда
			ВызватьИсключение "Немає доступу до цієї точки.";
		КонецЕсли;

		// если запрос уже обработан возвращаем прежнюю заметку без новой записи
		// тут реквизит id_запроса у справочника точно есть поэтому проверку на метаданные не делаем
		Если Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос;
			ЗапросДубль.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Заметки.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТорговыеТочкиЗаметки КАК Заметки
			|ГДЕ
			|	Заметки.ID_Запроса = &RequestID";
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);

			ВыборкаДубль = ЗапросДубль.Выполнить().Выбрать();
			Если ВыборкаДубль.Следующий() Тогда
				Результат = Новый Структура;
				Результат.Вставить("ok", Истина);
				Результат.Вставить("note", СтруктураЗаметки(ВыборкаДубль.Ссылка));
				Возврат ЗаметкиОтвет(200, ЗаметкиВJSON(Результат), Методы);
			КонецЕсли;
		КонецЕсли;

		// создаем новый элемент справочника и заполняем все поля
		НовыйЭлемент = Справочники.ТорговыеТочкиЗаметки.СоздатьЭлемент();
		НовыйЭлемент.ТорговаяТочка = ТочкаСсылка;
		НовыйЭлемент.Автор = Пользователь;
		НовыйЭлемент.ДатаЗаметки = ТекущаяДата();
		НовыйЭлемент.Метка = Метка;
		НовыйЭлемент.ТекстЗаметки = ТекстЗаметки;
		НовыйЭлемент.ID_Запроса = RequestID;
		// наименование это начало текста обрезанное до максимальной длины наименования в справочнике
		НовыйЭлемент.Наименование = Лев(ТекстЗаметки, НовыйЭлемент.Метаданные().ДлинаНаименования);

		Попытка
			НовыйЭлемент.Записать();
		Исключение
			// полный текст ошибки уходит в журнал а пользователю отдаем короткий
			ТекстЖурнала = ОписаниеОшибки();
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("КофеПриложение.Заметки", УровеньЖурналаРегистрации.Ошибка,
				, , ТекстЖурнала);
			ВызватьИсключение "Примітку не збережено: " + ТекстОшибки;
		КонецПопытки;

		// отдаем созданную заметку чтобы фронт сразу показал ее в истории
		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("note", СтруктураЗаметки(НовыйЭлемент.Ссылка));

		Возврат ЗаметкиОтвет(200, ЗаметкиВJSON(Результат), Методы);

	Исключение
		Возврат ЗаметкиОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции


// ответ на предварительный запрос браузера options для метода notes
// разрешаем и get и post потому что один адрес обслуживает оба
Функция OPTIONS_Notes(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции


// ============================================================
// метод goods (дерево номенклатуры для левой панели)
// с параметром parent показывает содержимое папки
// без параметра показывает корень
// с параметром q делает плоский поиск по всем товарам
// с параметром barcode ищет товар по штрихкоду
// ============================================================

// собирает ответ с заголовками для cors
// такая же как ЗаметкиОтвет только для метода goods
Функция ТоварыОтвет(КодОтвета, Тело, Методы, ЭтоJSON = Истина)
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", ?(ЭтоJSON, "application/json; charset=utf-8", "text/plain; charset=utf-8"));
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", Методы);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции


// превращает структуру или массив в строку json
Функция ТоварыВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// ============================================================
// метод goods (дерево номенклатуры для левой панели)
// с параметром parent показывает содержимое папки
// без параметра показывает корень
// с параметром q делает плоский поиск по всем товарам
// ============================================================

// читает параметр запроса как строку и не падает если параметра нет
Функция ПараметрТоваров(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции


// превращает uuid из строки в ссылку на папку номенклатуры
// если uuid пустой или битый возвращает пустую ссылку
// пустая ссылка в запросе означает корень дерева
Функция ТоварыСсылкаПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	// конструктор уникального идентификатора падает на кривой строке поэтому в попытке
	Попытка
		Уид = Новый УникальныйИдентификатор(Ид);
		Возврат Справочники.Номенклатура.ПолучитьСсылку(Уид);
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;
КонецФункции


// строит хлебные крошки от корня до указанной папки
// идем от текущей папки вверх по родителям и каждую вставляем в начало массива
Функция ТоварыХлебныеКрошки(Ссылка)
	Крошки = Новый Массив;
	Текущий = Ссылка;

	Пока ЗначениеЗаполнено(Текущий) Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id",   Строка(Текущий.УникальныйИдентификатор()));
		Элемент.Вставить("name", СокрЛП(Текущий.Наименование));
		// вставка по индексу ноль чтобы корень оказался первым
		Крошки.Вставить(0, Элемент);
		Текущий = Текущий.Родитель;
	КонецЦикла;

	Возврат Крошки;
КонецФункции


// служебное описание регистра цен — для понятной ошибки
// если запрос цен упадет то в тексте ошибки будет видно какие поля есть у регистра
Функция ТоварыОписаниеРегистраЦен()
	Инфо = "";
	Попытка
		Рег = Метаданные.РегистрыСведений.ЦеныНоменклатуры_переодический;
		Инфо = "Измерения:";
		Для Каждого Эл Из Рег.Измерения Цикл
			Инфо = Инфо + " " + Эл.Имя + ";";
		КонецЦикла;
		Инфо = Инфо + " Ресурсы:";
		Для Каждого Эл Из Рег.Ресурсы Цикл
			Инфо = Инфо + " " + Эл.Имя + ";";
		КонецЦикла;
	Исключение
		Инфо = "Регистр не найден в метаданных.";
	КонецПопытки;
	Возврат Инфо;
КонецФункции


// цены одним запросом на список ссылок
// у товара может быть много цен (разные типы цен и склады)
// поэтому выбираем лучшую по рангу (оптовая на основном складе важнее всего)
Функция ТоварыЦены(МассивСсылок)
	Цены = Новый Соответствие;
	// пустой список не гоняем в базу
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Цены;
	КонецЕсли;

	// срез последних берет самую свежую цену на текущую дату по каждому сочетанию измерений
	// цены равные нулю отбрасываем сразу
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.ТипЦен.Наименование КАК ТипЦен,
	|	Цены.Магазин.Наименование КАК Магазин,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры_переодический.СрезПоследних(
	|		&Дата,
	|		Номенклатура В (&Список)) КАК Цены
	|ГДЕ
	|	Цены.Цена > 0";
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Список", МассивСсылок);

	// при ошибке добавляем к тексту описание регистра чтобы было проще понять что не так
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + ТоварыОписаниеРегистраЦен();
	КонецПопытки;

	// ранги по товарам чем меньше число тем цена приоритетнее
	Ранги = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		// сравниваем в верхнем регистре чтобы не зависеть от того как написано в базе
		ТипЦен = ВРег(СокрЛП(Выборка.ТипЦен));
		Магазин = ВРег(СокрЛП(Выборка.Магазин));

		// оптовая лучше всего потом розничная потом все остальные
		Если ТипЦен = ВРег("Оптова") Тогда
			Ранг = 1;
		ИначеЕсли ТипЦен = ВРег("Розничная") Тогда
			Ранг = 3;
		Иначе
			Ранг = 5;
		КонецЕсли;

		// если цена не с основного склада то она хуже на единицу
		Если Магазин <> ВРег("Основной склад") Тогда
			Ранг = Ранг + 1;
		КонецЕсли;

		// запоминаем цену только если она лучше уже найденной для этого товара
		ТекущийРанг = Ранги[Выборка.Номенклатура];
		Если ТекущийРанг = Неопределено ИЛИ Ранг < ТекущийРанг Тогда
			Ранги.Вставить(Выборка.Номенклатура, Ранг);
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

	Возврат Цены;
КонецФункции

// остатки по списку товаров на основном складе сотрудника
// возвращает соответствие товар в количество
// если у пользователя не задан основной магазин возвращает неопределено и фронт просто не покажет остаток
Функция ТоварыОстатки(МассивСсылок, Пользователь)
	Остатки = Новый Соответствие;
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Остатки;
	КонецЕсли;

	Магазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// остатки одним запросом на весь список
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Номенклатура КАК Номенклатура,
	|	СУММА(Ост.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(
	|		,
	|		Магазин = &Магазин
	|		И Номенклатура В (&Список)) КАК Ост
	|СГРУППИРОВАТЬ ПО
	|	Ост.Номенклатура";
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Список", МассивСсылок);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;

	Возврат Остатки;
КонецФункции


// кладет остаток в позицию ответа
// если товара нет в регистре значит остаток ноль
Процедура ТоварыДобавитьОстаток(Позиция, Остатки, Ссылка)
	Если Остатки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ост = Остатки[Ссылка];
	Позиция.Вставить("stock", ?(Ост = Неопределено, 0, Ост));
КонецПроцедуры

// содержимое папки номенклатуры
// сначала идут папки потом товары и все по алфавиту
Функция ТоварыСодержимое(ИдРодителя, Пользователь)
	РодительСсылка = ТоварыСсылкаПоИд(ИдРодителя);

	// если id передали но ссылка получилась пустая значит такой папки нет
	Если Не ПустаяСтрока(ИдРодителя) И РодительСсылка.Пустая() Тогда
		ВызватьИсключение "Групу не знайдено.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование,
	|	Ном.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Родитель = &Родитель
	|	И НЕ Ном.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	Наименование";
	Запрос.УстановитьПараметр("Родитель", РодительСсылка);

	// выгружаем в таблицу значений чтобы пройти по ней дважды
	Таблица = Запрос.Выполнить().Выгрузить();

	// цены нужны только для товаров а не для папок
	МассивТоваров = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Если Не Стр.ЭтоГруппа Тогда
			МассивТоваров.Добавить(Стр.Ссылка);
		КонецЕсли;
	КонецЦикла;
	// все цены одним запросом
	Цены = ТоварыЦены(МассивТоваров);
	Остатки = ТоварыОстатки(МассивТоваров, Пользователь);

	Позиции = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Стр.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", СокрЛП(Стр.Наименование));
		// type говорит фронту что рисовать папку или товар
		Позиция.Вставить("type", ?(Стр.ЭтоГруппа, "folder", "item"));

		// у папки нет кода и цены
		Если НЕ Стр.ЭтоГруппа Тогда
			Позиция.Вставить("code", СокрЛП(Стр.Код));
			Цена = Цены[Стр.Ссылка];
			Позиция.Вставить("price", ?(Цена = Неопределено, 0, Цена));
			ТоварыДобавитьОстаток(Позиция, Остатки, Стр.Ссылка);
		КонецЕсли;

		Позиции.Добавить(Позиция);
	КонецЦикла;

	// parent и breadcrumb нужны фронту для кнопки назад и пути сверху
	Результат = Новый Структура;
	Результат.Вставить("parent",     ИдРодителя);
	Результат.Вставить("breadcrumb", ТоварыХлебныеКрошки(РодительСсылка));
	Результат.Вставить("items",      Позиции);
	Возврат Результат;
КонецФункции


// плоский поиск по всем товарам
// если ввели только цифры то ищем и по коду и по названию
// иначе только по названию
Функция ТоварыПоиск(СтрокаПоиска, Пользователь)
	СтрокаПоиска = СокрЛП(СтрокаПоиска);

	// проверяем что в строке только цифры
	// идем по символам и ищем каждый среди цифр
	ТолькоЦифры = Ложь;
	Если СтрДлина(СтрокаПоиска) > 0 Тогда
		ТолькоЦифры = Истина;
		Для Индекс = 1 По СтрДлина(СтрокаПоиска) Цикл
			Если Найти("0123456789", Сред(СтрокаПоиска, Индекс, 1)) = 0 Тогда
				ТолькоЦифры = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Запрос;

	Если ТолькоЦифры Тогда
		// код может быть числом или строкой и сравнивать его в запросе ненадежно
		// поэтому берем все товары и фильтруем уже в цикле ниже
		// внимание на большой базе это тяжело потому что тут нет первых n
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ном.Ссылка КАК Ссылка,
		|	Ном.Код КАК Код,
		|	Ном.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Ном
		|ГДЕ
		|	НЕ Ном.ПометкаУдаления
		|	И НЕ Ном.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	Ном.Код";
	Иначе
		// поиск по части названия
		// берем 51 чтобы понять что результатов больше пятидесяти
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 51
		|	Ном.Ссылка КАК Ссылка,
		|	Ном.Код КАК Код,
		|	Ном.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Ном
		|ГДЕ
		|	НЕ Ном.ПометкаУдаления
		|	И НЕ Ном.ЭтоГруппа
		|	И Ном.Наименование ПОДОБНО &МаскаИмени
		|УПОРЯДОЧИТЬ ПО
		|	Ном.Код";
		Запрос.УстановитьПараметр("МаскаИмени", "%" + СтрокаПоиска + "%");
	КонецЕсли;

	ВерхняяСтрока = ВРег(СтрокаПоиска);
	Позиции = Новый Массив;
	МассивСсылок = Новый Массив;
	// усечено значит нашлось больше пятидесяти и фронт покажет подсказку уточнить поиск
	Усечено = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		// код приводим к строке без разделителей групп чтобы 122065 не превратилось в 122 065
		КодСтрокой = ?(ТипЗнч(Выборка.Код) = Тип("Число"),
			Формат(Выборка.Код, "ЧГ=0"),
			СокрЛП(Выборка.Код));
		ИмяСтрокой = СокрЛП(Выборка.Наименование);

		// для цифрового поиска фильтруем здесь
		// подходит если цифры есть в коде или в названии
		Если ТолькоЦифры Тогда
			Если Найти(КодСтрокой, СтрокаПоиска) = 0
				И Найти(ВРег(ИмяСтрокой), ВерхняяСтрока) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// пятьдесят максимум для ответа
		Если Позиции.Количество() >= 50 Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", ИмяСтрокой);
		Позиция.Вставить("code", КодСтрокой);
		Позиция.Вставить("type", "item");
		Позиции.Добавить(Позиция);
		// ссылки копим отдельно для запроса цен
		МассивСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;

	// цены одним запросом на все найденное
	// индекс в массиве позиций совпадает с индексом в массиве ссылок
	Цены = ТоварыЦены(МассивСсылок);
	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Цена = Цены[МассивСсылок[Индекс]];
		Позиции[Индекс].Вставить("price", ?(Цена = Неопределено, 0, Цена));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items",     Позиции);
	Результат.Вставить("truncated", Усечено);
	Возврат Результат;
КонецФункции


// точка входа метода goods
// по параметрам решает что делать штрихкод поиск или просмотр папки
// точка входа метода goods
// по параметрам решает что делать штрихкод поиск или просмотр папки
Функция goodsget(Запрос)
	Методы = "GET, OPTIONS";
	Попытка
		// сначала проверяем кто спрашивает
		ПарамПользователя = ВернутьПараметрыСотрудника(ПараметрТоваров(Запрос, "u"));
		Если Не ЗначениеЗаполнено(ПарамПользователя.Сотрудник) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;
		// пользователь нужен всем веткам чтобы посчитать остаток на его складе
		Пользователь = ПарамПользователя.Пользователь;

		// --- блок штрих-кода ---
		// приоритет у штрихкода потому что скан должен сработать сразу
		ШтрихКод = ПараметрТоваров(Запрос, "barcode");
		Если Не ПустаяСтрока(ШтрихКод) Тогда
			Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыПоискПоШтрихкоду(ШтрихКод, Пользователь)), Методы);
		КонецЕсли;
		// ---------------------------------------

		// дальше обычный текстовый поиск
		СтрокаПоиска = ПараметрТоваров(Запрос, "q");
		Если Не ПустаяСтрока(СтрокаПоиска) Тогда
			Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыПоиск(СтрокаПоиска, Пользователь)), Методы);
		КонецЕсли;

		// если ни штрихкода ни поиска то показываем папку
		// пустой parent значит корень
		ИдРодителя = ПараметрТоваров(Запрос, "parent");
		Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыСодержимое(ИдРодителя, Пользователь)), Методы);

	Исключение
		Возврат ТоварыОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции

// поиск товара по штрихкоду: код единицы измерения (упаковки) = штрихкод,
// владелец единицы = номенклатура
// в нашей базе штрихкоды лежат не в табличной части номенклатуры а в справочнике единицы измерения
// мы это выяснили диагностикой когда перебирали все поля по значению отсканированного кода
Функция ТоварыПоискПоШтрихкоду(ШтрихКод, Пользователь)
	Ш = СокрЛП(ШтрихКод);

	// соединяем единицы измерения с номенклатурой через владельца
	// различные нужны если у одного товара несколько единиц с одним кодом
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК Ед
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Ед.Владелец = Ном.Ссылка
	|ГДЕ
	|	Ед.Код = &Код
	|	И НЕ Ед.ПометкаУдаления
	|	И НЕ Ном.ПометкаУдаления
	|	И НЕ Ном.ЭтоГруппа";
	Запрос.УстановитьПараметр("Код", Ш);

	Позиции = Новый Массив;
	МассивСсылок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	// формат позиции такой же как у обычного поиска чтобы фронт не пришлось менять
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", СокрЛП(Выборка.Наименование));
		Позиция.Вставить("code", ?(ТипЗнч(Выборка.Код) = Тип("Число"),
			Формат(Выборка.Код, "ЧГ=0"),
			СокрЛП(Выборка.Код)));
		Позиция.Вставить("type", "item");
		Позиции.Добавить(Позиция);
		МассивСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;

	// цены и остатки одним запросом на все найденное
	// индекс в массиве позиций совпадает с индексом в массиве ссылок
	Цены = ТоварыЦены(МассивСсылок);
	Остатки = ТоварыОстатки(МассивСсылок, Пользователь);
	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Цена = Цены[МассивСсылок[Индекс]];
		Позиции[Индекс].Вставить("price", ?(Цена = Неопределено, 0, Цена));
		ТоварыДобавитьОстаток(Позиции[Индекс], Остатки, МассивСсылок[Индекс]);
	КонецЦикла;

	// если ничего не нашли список будет пустой и фронт покажет что найдено ноль
	Возврат Новый Структура("items, truncated", Позиции, Ложь);
КонецФункции

// ============================================================
// метод machines
// принимает ?u=<код сотрудника>
// возвращает остатки склада, закреплённого за сотрудником
// склад тут это машина то есть основной магазин сотрудника
// ============================================================

Функция machinesget(Запрос)
	Попытка
		КодСотр = Запрос.ПараметрыЗапроса.Получить("u");
		Если КодСотр = Неопределено Тогда
			КодСотр = "";
		КонецЕсли;

		СтрокаJSON = ВернутьОстатокМашины(КодСотр);

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("Помилка 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции

Функция machinesoptions(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции


// возвращает json с остатками товаров на складе пользователя
// склад берётся из настроек пользователя (ОсновнойМагазин)
// цена по типу цен магазина (или ТипРозничнойЦены по умолчанию)
Функция ВернутьОстатокМашины(КодСотр)

	ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
	Сотр = ПарамПользователя.Сотрудник;
	Пользователь = ПарамПользователя.Пользователь;

	Если Не ЗначениеЗаполнено(Сотр) Тогда
		ВызватьИсключение "Співробітника не знайдено.";
	КонецЕсли;

	// склад машины берем из настроек пользователя через общий модуль глсобытия
	ОсновнойМагазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");

	// тип цен берем у магазина а если он не задан то общий розничный из переменных
	// внимание если основной магазин пустой то обращение к его реквизиту упадет
	ТипЦен = ?(ЗначениеЗаполнено(ОсновнойМагазин.ТипЦенНоменклатуры),
		ОсновнойМагазин.ТипЦенНоменклатуры,
		глЗначениеПеременной("ТипРозничнойЦены"));

	// остатки по всем товарам на складе этой машины
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ОстаткиОстатки.Номенклатура.Код КАК Код,
	|	ОстаткиОстатки.Номенклатура.Наименование КАК Наименование,
	|	ОстаткиОстатки.Номенклатура КАК Ссылка
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки КАК ОстаткиОстатки
	|ГДЕ
	|	ОстаткиОстатки.Магазин = &Магазин
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Запрос.УстановитьПараметр("Магазин", ОсновнойМагазин);

	Выборка = Запрос.Выполнить().Выбрать();

	// тут показываем все остатки в том числе нулевые и отрицательные
	// в отгрузке ниже отдельный запрос только с положительными
	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("Code", СокрЛП(Выборка.Код));
		Данные.Вставить("Name", Выборка.Наименование);
		Данные.Вставить("quantity", ?(Выборка.КоличествоОстаток = Неопределено, 0, Выборка.КоличествоОстаток));

		// цена отдельным запросом на каждый товар (медленнее чем в товарах но тут позиций немного)
		Цена = ПолучитьЦенуТовара(ТипЦен, Выборка.Ссылка);
		Данные.Вставить("price", ?(Цена = Неопределено, 0, Цена));

		МассивДанных.Добавить(Данные);
	КонецЦикла;

	// на складе пусто отдаем заглушку с пояснением
	Если МассивДанных.Количество() = 0 Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Залишки відсутні");
		Данные.Вставить("quantity", 0);
		Данные.Вставить("price", 0);
		МассивДанных.Добавить(Данные);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции


// возвращает цену номенклатуры по типу цен
// внимание тут читается регистр ЦеныНоменклатуры а в ТоварыЦены регистр ЦеныНоменклатуры_переодический
// это два разных регистра поэтому цена в машине и в дереве товаров может отличаться
Функция ПолучитьЦенуТовара(ТипЦен, Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры_переодический.СрезПоследних(
	|		&Дата,
	|		Номенклатура = &Номенклатура
	|		И ТипЦен = &ТипЦен) КАК Цены";

	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	Возврат 0;
КонецФункции

// ответ на предварительный запрос браузера options для метода goods
Функция goodsoptions(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции

// ============================================================
// метод shipment (відвантаження зі складу на точку)
// get отдаёт список товаров со склада пользователя
// post создаёт расходную накладную
// то есть товар уезжает со склада машины на торговую точку
// ============================================================

Функция shipmentget(Запрос)
	Попытка
		КодСотр = Запрос.ПараметрыЗапроса.Получить("u");
		Если КодСотр = Неопределено Тогда
			КодСотр = "";
		КонецЕсли;

		СтрокаJSON = ВернутьТоварыДляОтгрузки(КодСотр);

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки("Помилка 1С: " + ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции

// возвращает json с товарами и остатками на основном складе пользователя
// только положительные остатки потому что отгрузить можно только то что есть
Функция ВернутьТоварыДляОтгрузки(КодСотр)
	ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
	Сотр = ПарамПользователя.Сотрудник;
	Пользователь = ПарамПользователя.Пользователь;

	Если Не ЗначениеЗаполнено(Сотр) Тогда
		ВызватьИсключение "Співробітника не знайдено.";
	КонецЕсли;

	ОсновнойМагазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");

	// тут проверка на пустой магазин есть в отличие от метода machines
	Если Не ЗначениеЗаполнено(ОсновнойМагазин) Тогда
		ВызватьИсключение "У користувача не вказано основний магазин.";
	КонецЕсли;

	ТипЦен = ?(ЗначениеЗаполнено(ОсновнойМагазин.ТипЦенНоменклатуры),
		ОсновнойМагазин.ТипЦенНоменклатуры,
		глЗначениеПеременной("ТипРозничнойЦены"));

	// остатки больше нуля на складе сотрудника
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ОстаткиОстатки.Номенклатура.Код КАК Код,
	|	ОстаткиОстатки.Номенклатура.Наименование КАК Наименование,
	|	ОстаткиОстатки.Номенклатура КАК Ссылка
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки КАК ОстаткиОстатки
	|ГДЕ
	|	ОстаткиОстатки.Магазин = &Магазин
	|	И ОстаткиОстатки.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Запрос.УстановитьПараметр("Магазин", ОсновнойМагазин);
	Выборка = Запрос.Выполнить().Выбрать();

	// собираем массив для фронта
	МассивДанных = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = Новый Структура;
		Данные.Вставить("Code", СокрЛП(Выборка.Код));
		Данные.Вставить("Name", Выборка.Наименование);
		Данные.Вставить("quantity", ?(Выборка.КоличествоОстаток = Неопределено, 0, Выборка.КоличествоОстаток));

		Цена = ПолучитьЦенуТовара(ТипЦен, Выборка.Ссылка);
		Данные.Вставить("price", ?(Цена = Неопределено, 0, Цена));

		МассивДанных.Добавить(Данные);
	КонецЦикла;

	// ничего нет отдаем заглушку
	Если МассивДанных.Количество() = 0 Тогда
		Данные = Новый Структура;
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "На складі немає залишків");
		Данные.Вставить("quantity", 0);
		Данные.Вставить("price", 0);
		МассивДанных.Добавить(Данные);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДанных);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции


// создаёт и проводит расходную накладную
// накладная выписывается на контрагента точки со склада машины сотрудника
Функция POST_Shipment(Запрос)
	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();

		КодТочки    = Данные.point_id;
		КодСотр     = Данные.technician_id;
		МассивСтрок = Данные.items;

		RequestID = "";
		Если Данные.Свойство("request_id") Тогда
			RequestID = Данные.request_id;
		КонецЕсли;

		// защита от дублей
		ЕстьIDЗапроса = ЕстьРеквизитIDЗапроса("РасходнаяНакладная");
		Если ЕстьIDЗапроса И Не ПустаяСтрока(RequestID) Тогда
			ЗапросДубль = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.РасходнаяНакладная ГДЕ ID_Запроса = &RequestID");
			ЗапросДубль.УстановитьПараметр("RequestID", RequestID);
			Если Не ЗапросДубль.Выполнить().Пустой() Тогда
				// уже есть такая накладная отвечаем успехом без повторного создания
				Результат = Новый Структура("ok, doc_number, doc_date, sum, conduct_error", Истина, "", "", 0, "");
				ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку(); ЗаписатьJSON(ЗаписьJSON, Результат);
				Ответ = Новый HTTPСервисОтвет(200);
				Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
				Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
				Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотр);
		Сотр = ПарамПользователя.Сотрудник;
		Пользователь = ПарамПользователя.Пользователь;

		Если Не ЗначениеЗаполнено(Сотр) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;

		ОсновнойМагазин     = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
		ОсновнаяОрганизация = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнаяОрганизация");

		Если Не ЗначениеЗаполнено(ОсновнойМагазин) Тогда
			ВызватьИсключение "У користувача не вказано основний магазин.";
		КонецЕсли;

		ТочкаСсылка = Справочники.ТорговыеТочки.НайтиПоКоду(СокрЛП(КодТочки));
		Если ТочкаСсылка.Пустая() Тогда
			ВызватьИсключение "Точка з кодом " + КодТочки + " не знайдена.";
		КонецЕсли;

		// пустую отгрузку не создаем
		Если МассивСтрок = Неопределено ИЛИ МассивСтрок.Количество() = 0 Тогда
			ВызватьИсключение "Порожній список відвантаження.";
		КонецЕсли;

		// создаём документ
		НовыйДок = Документы.РасходнаяНакладная.СоздатьДокумент();
		НовыйДок.Дата = ТекущаяДата();
		НовыйДок.Организация = ОсновнаяОрганизация;
		НовыйДок.Контрагент = ТочкаСсылка.Контрагент;

		// реквизит Автор есть в форме, но его может не быть — пишем в попытке
		Попытка НовыйДок.Автор = Пользователь; Исключение КонецПопытки;

		// Склад тут основной магазин сотрудника (склад-машина)
		Попытка НовыйДок.Магазин = ОсновнойМагазин; Исключение КонецПопытки;
		Попытка НовыйДок.Менеджер = Сотр; Исключение КонецПопытки;

		// Основание оставляем пустым, если у вас нет конкретного документа

		Если ЕстьIDЗапроса Тогда
			Попытка НовыйДок.ID_Запроса = RequestID; Исключение КонецПопытки;
		КонецЕсли;

		СуммаОбщая = 0;

		// разбираем позиции отгрузки так же как в заказе
		Для Каждого Стр Из МассивСтрок Цикл
			КодТовара = "";
			Если Стр.Свойство("code") Тогда
				КодТовара = СокрЛП(Стр.code);
			КонецЕсли;

			ИмяТовара = "";
			Если Стр.Свойство("name") Тогда
				ИмяТовара = СокрЛП(Стр.name);
			КонецЕсли;

			Кол = 0;
			Если Стр.Свойство("qty") Тогда
				Кол = Число(Стр.qty);
			КонецЕсли;

			// цену тут берем с фронта (в отличие от meters где она из базы)
			Цена = 0;
			Если Стр.Свойство("price") Тогда
				Цена = Число(Стр.price);
			КонецЕсли;

			// нулевое количество пропускаем
			Если Кол <= 0 Тогда
				Продолжить;
			КонецЕсли;

			// товар по коду потом по имени
			Товар = Справочники.Номенклатура.ПустаяСсылка();
			Если Не ПустаяСтрока(КодТовара) Тогда
				Попытка
					Товар = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
				Исключение
				КонецПопытки;
			КонецЕсли;
			Если Товар.Пустая() И Не ПустаяСтрока(ИмяТовара) Тогда
				Товар = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара);
			КонецЕсли;
			// не нашли значит пропускаем
			Если Товар.Пустая() Тогда
				Продолжить;
			КонецЕсли;

			// ТЧ называется Состав
			НоваяСтр = НовыйДок.Состав.Добавить();
			НоваяСтр.Номенклатура = Товар;
			НоваяСтр.Количество = Кол;
			НоваяСтр.Цена = Цена;
			НоваяСтр.Сумма = Кол * Цена;

			СуммаОбщая = СуммаОбщая + НоваяСтр.Сумма;
		КонецЦикла;

		// если ни одной позиции не нашли то отгружать нечего
		Если НовыйДок.Состав.Количество() = 0 Тогда
			ВызватьИсключение "Жодна позиція не знайдена в номенклатурі.";
		КонецЕсли;

		// проводим; если не провелось сохраняем без проведения и возвращаем conduct_error
		// причина может быть в нехватке остатка на складе
		ОшибкаПроведения = "";
		Попытка
			НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОшибкаПроведения = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("КофеПриложение.Відвантаження",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не вдалося провести документ: " + ОшибкаПроведения);
			// запасной вариант записать без проведения чтобы накладная не потерялась
			Попытка
				НовыйДок.Записать(РежимЗаписиДокумента.Запись);
			Исключение
				ВызватьИсключение "Не вдалося записати документ: " + ОписаниеОшибки();
			КонецПопытки;
		КонецПопытки;

		// ответ фронту с номером датой и суммой накладной
		Результат = Новый Структура;
		Результат.Вставить("ok", Истина);
		Результат.Вставить("doc_number", СокрЛП(НовыйДок.Номер));
		Результат.Вставить("doc_date", Формат(НовыйДок.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"));
		Результат.Вставить("sum", СуммаОбщая);
		Результат.Вставить("conduct_error", ОшибкаПроведения);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Результат);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
		Возврат Ответ;

	Исключение
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
		Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), КодировкаТекста.UTF8);
		Возврат Ответ;
	КонецПопытки;
КонецФункции

// ответ на предварительный запрос браузера options для метода shipment
// разрешены get и post потому что метод умеет оба
Функция shipmentoptions(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции
